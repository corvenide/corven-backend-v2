# Your app id from POST /connect/v1/admin/apps
VITE_CORVEN_APP_ID=app_xxxxxxxxxxxxxxxx
# Leave empty for Corven's hosted API, or point at a local connect-service
VITE_CORVEN_API_URL=http://127.0.0.1:8007/connect/v1
# Optional: a local devnet (offckb) instead of the public testnet
VITE_CKB_RPC_URL=
# JSON of the devnet's known scripts (offckb's scripts), when using a devnet
VITE_CKB_SCRIPTS=
