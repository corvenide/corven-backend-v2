# Copy to deploy/.env (deploy/setup-server.sh does this and fills in secrets).

# Domains. Both need DNS A records pointing at the server's static IP.
API_DOMAIN=staging-api.corvanide.space
WEB_DOMAIN=corvanide.space

# Frontend origins allowed to call the API with credentials (comma-separated).
CORS_ORIGINS=https://corvanide.space,https://www.corvanide.space

# Where the frontend build is published on the host.
WEB_ROOT=/opt/corven/web

# PostgreSQL (the postgres container). To use a Lightsail managed database
# instead, point DATABASE_URL at it and add ?sslmode=require.
POSTGRES_USER=corven
POSTGRES_PASSWORD=change-me
POSTGRES_DB=corven
DATABASE_URL=postgresql://corven:change-me@postgres:5432/corven

NODE_ENV=production

# Auth. JWT_SECRET must be at least 32 random characters.
JWT_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
# The frontend (corvanide.space) and API (staging-api.corvanide.space) are the
# same site, so the default Lax refresh cookie works. Use "none" only if the
# frontend moves to a different domain.
REFRESH_COOKIE_SAMESITE=lax
# Name shown in the wallet sign-in message.
APP_ORIGIN=corvanide.space
# Caddy sits in front of the gateway: one proxy hop.
TRUST_PROXY_HOPS=1

# Claude assistant (/api/ai/*). Leave the key empty to turn it off.
ANTHROPIC_API_KEY=
AI_REQUESTS_PER_10_MIN=40

# Service addresses as seen by the services that call them. docker-compose.yml
# overrides each service's own *_HOST to 0.0.0.0 so it listens on all interfaces.
API_GATEWAY_PORT=8000
AUTH_SERVICE_HOST=auth-service
AUTH_SERVICE_PORT=8001
WORKSPACE_SERVICE_HOST=workspace-service
WORKSPACE_SERVICE_PORT=8002
RUNTIME_SERVICE_HOST=runtime-service
RUNTIME_SERVICE_PORT=8003
TERMINAL_SERVICE_PORT=8004
FILE_SERVICE_HOST=file-service
FILE_SERVICE_PORT=8005

# Workspace containers
DOCKER_SOCKET_PATH=/var/run/docker.sock
# How many workspaces may run at once on this server. Each needs about 3 GB of
# RAM, so use (RAM in GB - 2) / 3, e.g. 4 on a 16 GB instance.
HOST_MAX_WORKSPACES=4
# Stop workspaces nobody has used for this many minutes.
WORKSPACE_IDLE_MINUTES=20
# Pre-started build containers kept ready for fast starts (each holds RAM).
RUNTIME_POOL_SIZE=1
# lazy: start a workspace's CKB devnet only when it's needed.
DEVNET_MODE=lazy
CKB_NODE_IMAGE=fiberdev/ckb-node:dev
FIBER_RUNTIME_IMAGE=fiberdev/ckb-runtime:dev
DEFAULT_PROJECT_NAME=ckb-rust-script
DEFAULT_CONTRACT_NAME=hello-world

# Per-workspace limits: 1 GB / 1 CPU for the CKB node, 2 GB / 2 CPUs for the
# build container. A running workspace needs about 3 GB of RAM in total.
CKB_NODE_MEMORY_BYTES=1073741824
CKB_NODE_NANO_CPUS=1000000000
RUNTIME_MEMORY_BYTES=2147483648
RUNTIME_NANO_CPUS=2000000000

# ---------------------------------------------------------------------------
# Corven Connect (https://API_DOMAIN/connect/v1). Separate from the IDE: its
# own users, secrets and wallet key. Never reuse the IDE values here.
# ---------------------------------------------------------------------------
CONNECT_SERVICE_PORT=8007
# 32+ random characters, different from JWT_SECRET (openssl rand -base64 48)
CONNECT_JWT_SECRET=change-me
# 32 random bytes (openssl rand -base64 32). Back it up off the server:
# losing it makes every Connect wallet unrecoverable. Never change it.
CONNECT_WALLET_ENCRYPTION_KEY=
# Bearer token for /connect/v1/admin/apps (registering apps). 24+ characters.
CONNECT_ADMIN_TOKEN=
# Phone and email codes: twilio (production) or console (development only).
CONNECT_OTP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Numbers typed without a country code (0712 345 678) are treated as Kenyan.
CONNECT_DEFAULT_COUNTRY_CODE=254
# Fallback Google client id for apps that don't set their own.
CONNECT_GOOGLE_CLIENT_ID=
# CKB leaving a mainnet wallet per user per 24 hours. 0 turns mainnet off.
CONNECT_MAINNET_DAILY_LIMIT_CKB=1000
# Optional RPC overrides (public nodes are used by default).
CONNECT_CKB_TESTNET_RPC_URL=
CONNECT_CKB_MAINNET_RPC_URL=
