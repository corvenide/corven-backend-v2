{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/api-gateway/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "webpackConfigPath": "./webpack.config.js",
    "tsConfigPath": "apps/api-gateway/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/api-gateway",
  "projects": {
    "api-gateway": {
      "type": "application",
      "root": "apps/api-gateway",
      "entryFile": "main",
      "sourceRoot": "apps/api-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-gateway/tsconfig.app.json"
      }
    },
    "auth-service": {
      "type": "application",
      "root": "apps/auth-service",
      "entryFile": "main",
      "sourceRoot": "apps/auth-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth-service/tsconfig.app.json"
      }
    },
    "cell-service": {
      "type": "application",
      "root": "apps/cell-service",
      "entryFile": "main",
      "sourceRoot": "apps/cell-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/cell-service/tsconfig.app.json"
      }
    },
    "connect-service": {
      "type": "application",
      "root": "apps/connect-service",
      "entryFile": "main",
      "sourceRoot": "apps/connect-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/connect-service/tsconfig.app.json"
      }
    },
    "file-service": {
      "type": "application",
      "root": "apps/file-service",
      "entryFile": "main",
      "sourceRoot": "apps/file-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/file-service/tsconfig.app.json"
      }
    },
    "prisma": {
      "type": "library",
      "root": "libs/prisma",
      "entryFile": "index",
      "sourceRoot": "libs/prisma/src",
      "compilerOptions": {
        "tsConfigPath": "libs/prisma/tsconfig.lib.json"
      }
    },
    "runtime-service": {
      "type": "application",
      "root": "apps/runtime-service",
      "entryFile": "main",
      "sourceRoot": "apps/runtime-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/runtime-service/tsconfig.app.json"
      }
    },
    "terminal-service": {
      "type": "application",
      "root": "apps/terminal-service",
      "entryFile": "main",
      "sourceRoot": "apps/terminal-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/terminal-service/tsconfig.app.json"
      }
    },
    "workspace-service": {
      "type": "application",
      "root": "apps/workspace-service",
      "entryFile": "main",
      "sourceRoot": "apps/workspace-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/workspace-service/tsconfig.app.json"
      }
    }
  }
}
