generator client {
    provider     = "prisma-client"
    output       = "../src/generated/prisma"
    moduleFormat = "cjs"
}

datasource db {
    provider = "postgresql"
}

enum WorkspaceStatus {
    PENDING
    PROVISIONING
    RUNNING
    IDLE
    STOPPED
    FAILED
    DELETED
}

enum UserRole {
    USER
    ADMIN
}

enum RuntimeContainerType {
    IDE
    CKB_NODE
    FIBER_RUNTIME
    PREVIEW
    TEST_RUNNER
}

enum RuntimeContainerStatus {
    CREATED
    STARTING
    RUNNING
    STOPPED
    FAILED
}

enum HostStatus {
    ONLINE
    OFFLINE
}

enum DeployNetwork {
    DEVNET
    TESTNET
    MAINNET
}

enum AuthProvider {
    EMAIL
    CKB_WALLET
    GOOGLE
}

enum CellStatus {
    LIVE
    DEAD
}

enum ScriptKind {
    LOCK
    TYPE
}

enum HashType {
    DATA
    TYPE
    DATA1
}

enum TxStatus {
    PENDING
    PROPOSED
    COMMITTED
    REJECTED
}

model User {
    id String @id @default(uuid())

    name         String
    email        String? @unique
    passwordHash String?

    walletAddress String?      @unique
    /// Google account id (the ID token's `sub`), for Google sign-in.
    googleId      String?      @unique
    authProvider  AuthProvider @default(EMAIL)

    role UserRole @default(USER)

    workspaces       Workspace[]
    walletChallenges WalletChallenge[]
    refreshTokens    RefreshToken[]

    communityPosts    CommunityPost[]
    communityComments CommunityComment[]
    communityVotes    CommunityVote[]

    wallets         UserWallet[]
    walletTransfers WalletTransfer[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([walletAddress])
}

// ---------------------------------------------------------------------------
// Community: news (admins only), feedback and proposals (any signed-in user)
// ---------------------------------------------------------------------------

enum CommunityPostKind {
    NEWS
    FEEDBACK
    PROPOSAL
}

/// Where a feedback item or proposal stands. Only admins change it.
enum CommunityPostStatus {
    OPEN
    PLANNED
    IN_PROGRESS
    DONE
    DECLINED
}

model CommunityPost {
    id String @id @default(uuid())

    kind   CommunityPostKind
    title  String
    body   String
    status CommunityPostStatus @default(OPEN)
    pinned Boolean             @default(false)

    authorId String
    author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

    comments CommunityComment[]
    votes    CommunityVote[]

    // Kept in step with the comments and votes tables, so lists don't count rows.
    voteCount    Int @default(0)
    commentCount Int @default(0)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([kind, createdAt])
    @@index([kind, voteCount])
    @@index([authorId])
}

model CommunityComment {
    id String @id @default(uuid())

    postId String
    post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

    authorId String
    author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

    body String

    createdAt DateTime @default(now())

    @@index([postId, createdAt])
    @@index([authorId])
}

/// One upvote per user per post.
model CommunityVote {
    postId String
    post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())

    @@id([postId, userId])
    @@index([userId])
}

model WalletChallenge {
    id String @id @default(uuid())

    walletAddress String
    nonce         String @unique
    message       String

    expiresAt DateTime
    usedAt    DateTime?

    userId String?
    user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())

    @@index([walletAddress])
    @@index([expiresAt])
}

/// One row per issued refresh token. Tokens are stored hashed (SHA-256).
/// Every rotation creates a new row in the same `familyId`; reusing a
/// revoked token revokes the whole family (theft detection).
model RefreshToken {
    id String @id @default(uuid())

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    tokenHash String @unique
    familyId  String

    expiresAt    DateTime
    revokedAt    DateTime?
    replacedById String?
    lastUsedAt   DateTime?

    userAgent String?
    ipAddress String?

    createdAt DateTime @default(now())

    @@index([userId])
    @@index([familyId])
    @@index([expiresAt])
}

/// A Docker host that runs workspaces. Rows are kept in step with the
/// DOCKER_HOSTS setting by runtime-service; `draining` is set by operators
/// to move workspaces off a host as they restart.
model Host {
    /// Same id as in DOCKER_HOSTS.
    id       String @id
    /// Endpoint without credentials, for display.
    endpoint String

    status   HostStatus @default(ONLINE)
    draining Boolean    @default(false)

    maxWorkspaces Int @default(8)

    /// From the Docker engine at the last health check.
    cpus              Int?
    memoryBytes       BigInt?
    containersRunning Int?
    lastSeenAt        DateTime?
    lastError         String?

    workspaces Workspace[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Workspace {
    id     String          @id @default(uuid())
    name   String
    status WorkspaceStatus @default(PENDING)

    /// Host the workspace's containers and volumes live on. Assigned on
    /// first start and kept (volumes are local to a host). Null = the
    /// default host, for workspaces created before multi-host support.
    hostId String?
    host   Host?   @relation(fields: [hostId], references: [id], onDelete: SetNull)

    userId String

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    templateId String?

    runtimeNetwork String?
    runtimeVolume  String?
    ckbDataVolume  String?

    lastStartedAt DateTime?
    lastStoppedAt DateTime?

    /// Current step while status is PROVISIONING (preparing | starting | project).
    provisionStage String?
    /// Why the last start failed, shown to the user.
    provisionError String?

    /// Last sign of use (open IDE tab, terminal input, file edits, builds).
    /// Running workspaces idle for too long are stopped automatically.
    lastActivityAt DateTime?

    /// When the source-file copy in WorkspaceFile was last refreshed from
    /// the container. Null until the workspace has run once.
    filesSnapshotAt DateTime?

    containers  WorkspaceContainer[]
    files       WorkspaceFile[]
    deployments ContractDeployment[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([userId])
    @@index([status])
    @@index([createdAt])
    @@index([hostId, status])
}

/// Copy of a workspace's source files, so the editor works while the
/// runtime container is stopped. Build output (target/, build/) and .git are
/// not stored. Edits made while offline are flagged `dirty` / `deleted` and
/// applied to the container on the next start.
model WorkspaceFile {
    id String @id @default(uuid())

    workspaceId String
    workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

    path        String
    isDirectory Boolean @default(false)
    content     String  @default("")
    size        Int     @default(0)

    dirty   Boolean @default(false)
    deleted Boolean @default(false)

    updatedAt DateTime @updatedAt

    @@unique([workspaceId, path])
    @@index([workspaceId, dirty])
}

/// A contract deployed from a workspace. Devnet deploys are made by
/// runtime-service (offckb); testnet/mainnet deploys are signed in the
/// user's wallet and recorded here afterwards.
model ContractDeployment {
    id String @id @default(uuid())

    workspaceId String
    workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
    userId      String

    network      DeployNetwork
    contractName String

    /// Where the code cell is (the cell dep users add to their transactions).
    txHash      String
    outputIndex Int    @default(0)

    /// Script fields that reference this contract.
    codeHash String
    hashType String

    /// Set for upgradable (Type ID) deploys; stays the same across upgrades.
    typeId   String?
    /// Type ID script args, needed to upgrade the cell from the wallet.
    typeArgs String?

    dataHash  String
    sizeBytes Int
    /// Occupied capacity in shannons.
    capacity  String

    /// Lock address that owns the code cell (testnet/mainnet).
    deployerAddress String?

    /// Earlier deployment this one replaced (Type ID upgrade).
    upgradeOfId String?

    createdAt DateTime @default(now())

    @@index([workspaceId, createdAt])
    @@index([typeId])
}

model WorkspaceContainer {
    id String @id @default(uuid())

    workspaceId String

    workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

    containerId String @unique
    name        String
    image       String

    type RuntimeContainerType

    status RuntimeContainerStatus @default(CREATED)

    internalPort Int?
    hostPort     Int?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([workspaceId, type])
    @@index([workspaceId])
    @@index([containerId])
    @@index([status])
    @@index([type])
}

model Block {
    id String @id @default(uuid())

    number     BigInt @unique
    hash       String @unique
    parentHash String

    epoch     String?
    timeStamp DateTime

    createdAt DateTime @default(now())

    transactions Transaction[]
}

model Transaction {
    id   String @id @default(uuid())
    hash String @unique

    blockId String?
    block   Block?  @relation(fields: [blockId], references: [id])

    fee    String?
    cycles BigInt?

    status TxStatus

    createdAt DateTime @default(now())

    inputs  Cell[] @relation("ConsumedCells")
    outputs Cell[] @relation("CreatedCells")
}

model Cell {
    id String @id @default(cuid())

    txHash String

    outputIndex Int

    outPoint String @unique

    capacity String

    data String?

    status CellStatus

    lockScriptId String

    typeScriptId String?

    createdByTxId String

    consumedByTxId String?

    createdBlockId String?

    consumedBlockId String?

    lockScript Script @relation("LockScript", fields: [lockScriptId], references: [id])

    typeScript Script? @relation("TypeScript", fields: [typeScriptId], references: [id])

    createdBy Transaction @relation("CreatedCells", fields: [createdByTxId], references: [id])

    consumedBy Transaction? @relation("ConsumedCells", fields: [consumedByTxId], references: [id])

    addressId String?

    address Address? @relation(fields: [addressId], references: [id])

    createdAt DateTime @default(now())
}

model Script {
    id String @id @default(cuid())

    codeHash String

    hashType HashType

    args String

    scriptHash String @unique

    kind ScriptKind

    cellsAsLock Cell[] @relation("LockScript")
    cellsAsType Cell[] @relation("TypeScript")
}

model Address {
    id String @id @default(cuid())

    address String @unique

    balance String

    liveCapacity String

    occupiedCapacity String

    freeCapacity String

    cells Cell[]
}


enum WalletNetwork {
    TESTNET
    MAINNET
}

/// A CKB wallet Corven holds for a user who signed in with Google (one per
/// network). The private key is encrypted with a per-wallet data key, which
/// is itself encrypted with WALLET_ENCRYPTION_KEY (see apps/auth-service
/// wallets/wallet-vault.ts). Neither key is ever stored in plain text.
model UserWallet {
    id String @id @default(uuid())

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    network   WalletNetwork
    address   String
    /// Compressed secp256k1 public key (0x…), safe to share.
    publicKey String

    /// AES-256-GCM: base64(iv | tag | ciphertext) of the private key.
    encryptedKey   String
    /// AES-256-GCM: base64(iv | tag | ciphertext) of the data key, under the master key.
    wrappedDataKey String
    /// Which master key wrapped the data key (for rotation).
    keyVersion     Int    @default(1)

    exportedAt DateTime?
    createdAt  DateTime  @default(now())

    transfers WalletTransfer[]

    @@unique([userId, network])
    @@index([address])
}

/// CKB sent from a Corven wallet, for history and the mainnet daily limit.
model WalletTransfer {
    id String @id @default(uuid())

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    walletId String
    wallet   UserWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

    network   WalletNetwork
    toAddress String
    /// Shannons, as a decimal string.
    amount    String
    txHash    String

    createdAt DateTime @default(now())

    @@index([userId, network, createdAt])
}

// ===========================================================================
// Corven Connect: embedded CKB wallets with social and phone sign-in for
// other apps (the SDK in packages/connect). Separate from Corven IDE users:
// its own users, sessions, signing secret (CONNECT_JWT_SECRET) and wallet
// master key (CONNECT_WALLET_ENCRYPTION_KEY). Served by apps/connect-service.
// ===========================================================================

enum ConnectIdentityKind {
    PHONE
    EMAIL
    GOOGLE
    /// A CKB address of a wallet the person already has (JoyID, UniSat, MetaMask...).
    WALLET
}

/// An app that embeds Corven Connect. Its id is the public app id the SDK
/// sends; only pages on `allowedOrigins` may use it.
model ConnectApp {
    id   String @id
    name String

    /// Exact origins, e.g. https://myapp.xyz, http://localhost:5173.
    allowedOrigins String[]
    /// Google OAuth client id whose authorized origins include the app's pages.
    googleClientId String?
    /// Sign-in methods offered: PHONE, EMAIL, GOOGLE, PASSKEY, WALLET.
    loginMethods   String[] @default(["PHONE", "EMAIL", "GOOGLE", "PASSKEY", "WALLET"])
    /// Mainnet wallets can sign only when this is on.
    mainnetEnabled Boolean  @default(false)

    logoUrl String?

    /// Corven IDE user who created it (dashboard); null for admin-created apps.
    createdById String?

    users   ConnectUser[]
    members ConnectAppMember[]
    invites ConnectAppInvite[]
    events  ConnectEvent[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

/// A person signed in to one Connect app. Users of different apps are
/// different rows, so one app can never act for another app's users.
model ConnectUser {
    id String @id @default(uuid())

    appId String
    app   ConnectApp @relation(fields: [appId], references: [id], onDelete: Cascade)

    displayName String?
    /// False for people who signed up with their own wallet: they sign with
    /// it, so Corven holds no keys for them.
    embeddedWallets Boolean @default(true)

    identities ConnectIdentity[]
    passkeys   ConnectPasskey[]
    sessions   ConnectSession[]
    wallets    ConnectWallet[]
    signatures ConnectSignature[]

    lastLoginAt DateTime?
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    @@index([appId])
}

/// A verified way to sign in: phone number (E.164), email (lowercase),
/// Google account id (`sub`) or wallet address. Unique per app.
model ConnectIdentity {
    id String @id @default(uuid())

    appId  String
    userId String
    user   ConnectUser @relation(fields: [userId], references: [id], onDelete: Cascade)

    kind  ConnectIdentityKind
    value String
    /// Email shown for a Google identity; wallet name for a wallet.
    label String?

    verifiedAt DateTime @default(now())
    createdAt  DateTime @default(now())

    @@unique([appId, kind, value])
    @@index([userId])
}

/// A WebAuthn credential. `rpId` is the app's domain it was created on.
model ConnectPasskey {
    id String @id @default(uuid())

    userId String
    user   ConnectUser @relation(fields: [userId], references: [id], onDelete: Cascade)

    credentialId String   @unique
    /// COSE public key, base64url.
    publicKey    String
    counter      Int      @default(0)
    transports   String[]
    rpId         String
    name         String?

    lastUsedAt DateTime?
    createdAt  DateTime  @default(now())

    @@index([userId])
}

/// Refresh tokens (SHA-256 hashed), rotated on every use; reusing a revoked
/// one revokes its whole family.
model ConnectSession {
    id String @id @default(uuid())

    userId String
    user   ConnectUser @relation(fields: [userId], references: [id], onDelete: Cascade)

    tokenHash String @unique
    familyId  String

    expiresAt    DateTime
    revokedAt    DateTime?
    replacedById String?

    userAgent String?
    ipAddress String?
    origin    String?

    createdAt DateTime @default(now())

    @@index([userId])
    @@index([familyId])
}

/// One CKB wallet per user and network. Private key sealed like the IDE's
/// wallets but with its own master key (CONNECT_WALLET_ENCRYPTION_KEY).
model ConnectWallet {
    id String @id @default(uuid())

    userId String
    user   ConnectUser @relation(fields: [userId], references: [id], onDelete: Cascade)

    network   WalletNetwork
    address   String
    publicKey String

    encryptedKey   String
    wrappedDataKey String
    keyVersion     Int    @default(1)

    exportedAt DateTime?
    createdAt  DateTime  @default(now())

    signatures ConnectSignature[]

    @@unique([userId, network])
    @@index([address])
}

/// Every transaction a Connect wallet signed: audit trail and the mainnet
/// daily limit. `outflow` is CKB that leaves the wallet, in shannons.
model ConnectSignature {
    id String @id @default(uuid())

    userId String
    user   ConnectUser @relation(fields: [userId], references: [id], onDelete: Cascade)

    walletId String
    wallet   ConnectWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

    network WalletNetwork
    txHash  String
    outflow String
    origin  String?

    createdAt DateTime @default(now())

    @@index([userId, network, createdAt])
}

enum ConnectAppRole {
    /// Everything, including team roles, mainnet and deleting the app.
    OWNER
    /// Settings, users and inviting admins/viewers.
    ADMIN
    /// Read-only.
    VIEWER
}

/// A Corven IDE account that manages a Connect app in the dashboard.
/// `userId` is the IDE User id (kept as a plain id so Connect stays separate).
model ConnectAppMember {
    id String @id @default(uuid())

    appId String
    app   ConnectApp @relation(fields: [appId], references: [id], onDelete: Cascade)

    userId String
    role   ConnectAppRole

    createdAt DateTime @default(now())

    @@unique([appId, userId])
    @@index([userId])
}

/// An invite link to join an app's team (token stored hashed, 7 days).
model ConnectAppInvite {
    id String @id @default(uuid())

    appId String
    app   ConnectApp @relation(fields: [appId], references: [id], onDelete: Cascade)

    email     String?
    role      ConnectAppRole
    tokenHash String         @unique

    invitedById  String
    acceptedById String?
    acceptedAt   DateTime?
    revokedAt    DateTime?
    expiresAt    DateTime

    createdAt DateTime @default(now())

    @@index([appId])
}

enum ConnectEventKind {
    SIGN_UP
    SIGN_IN
    CODE_SENT
    TX_SIGNED
}

/// Usage events for the dashboard's stats. `method` is e.g. PHONE, GOOGLE, sms, TESTNET.
model ConnectEvent {
    id String @id @default(uuid())

    appId String
    app   ConnectApp @relation(fields: [appId], references: [id], onDelete: Cascade)

    kind   ConnectEventKind
    method String?

    createdAt DateTime @default(now())

    @@index([appId, createdAt])
}
